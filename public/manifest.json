{
  "manifest_version": 3,
  "name": "TabMarker",
  "version": "0.4.8",
  "description": "Persistent custom tab titles and colored favicons. Local rules, no accounts or tracking.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "contextMenus",
    "nativeMessaging",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Customize this tab · TabMarker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
