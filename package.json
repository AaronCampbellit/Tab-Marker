{
  "name": "tabmarker",
  "version": "0.4.9",
  "private": true,
  "type": "module",
  "description": "Local-first persistent tab titles and colored favicons for Chrome.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run version:sync && npm run typecheck && vite build && node scripts/bundle.mjs",
    "version": "node scripts/sync-version.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:browser": "npm run build && playwright test",
    "test:all": "npm run test:unit && npm run test:content && npm run test:browser",
    "test:content": "npm run build && playwright test --config=playwright.content.config.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
